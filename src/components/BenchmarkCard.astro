---
import { withBase } from '@utils';

export interface BenchmarkResult {
  modeloId: string;
  puntuacion: number;
  fecha: string;
}

export interface Props {
  id: string;
  nombre: string;
  descripcion: string;
  resultados: BenchmarkResult[];
  fuente?: string;
}

const { id, nombre, descripcion, resultados, fuente } = Astro.props;

// Derive category from id
const categoria = id;

const categoriaColors: Record<string, string> = {
  'coding': 'bg-blue-100 text-blue-800',
  'reasoning': 'bg-purple-100 text-purple-800',
  'context': 'bg-green-100 text-green-800',
  'speed': 'bg-yellow-100 text-yellow-800'
};

const categoriaLabels: Record<string, string> = {
  'coding': 'Programación',
  'reasoning': 'Razonamiento',
  'context': 'Contexto',
  'speed': 'Velocidad'
};

// Sort results by score descending
const sortedResults = [...resultados].sort((a, b) => b.puntuacion - a.puntuacion);

function getScoreColor(score: number): string {
  if (score >= 90) return 'text-green-600';
  if (score >= 70) return 'text-blue-600';
  if (score >= 50) return 'text-yellow-600';
  return 'text-red-600';
}

function getScoreBg(score: number): string {
  if (score >= 90) return 'bg-green-100';
  if (score >= 70) return 'bg-blue-100';
  if (score >= 50) return 'bg-yellow-100';
  return 'bg-red-100';
}
---

<a href={withBase(`/benchmarks/${id}/`)} class="block bg-white rounded-xl shadow-md hover:shadow-lg transition-shadow duration-300 overflow-hidden border border-gray-100">
  <div class="p-6">
    <div class="flex items-start justify-between mb-4">
      <div>
        <h3 class="text-xl font-bold text-gray-900">{nombre}</h3>
        <span class={`inline-block mt-1 px-3 py-1 rounded-full text-xs font-medium ${categoriaColors[categoria] || 'bg-gray-100 text-gray-800'}`}>
          {categoriaLabels[categoria] || categoria}
        </span>
      </div>
    </div>
    
    <p class="text-gray-600 text-sm mb-4">{descripcion}</p>
    
    {fuente && (
      <p class="text-xs text-gray-500 mb-4">Fuente: {fuente}</p>
    )}
    
    <div class="space-y-2">
      <p class="text-sm font-medium text-gray-700">Top 5 Modelos:</p>
      <div class="space-y-2">
        {sortedResults.slice(0, 5).map((resultado, index) => (
          <div class="flex items-center justify-between p-2 rounded-lg bg-gray-50">
            <div class="flex items-center gap-2">
              <span class={`w-6 h-6 rounded-full flex items-center justify-center text-xs font-bold ${index === 0 ? 'bg-yellow-400 text-yellow-900' : 'bg-gray-200 text-gray-600'}`}>
                {index + 1}
              </span>
              <span class="text-sm font-medium text-gray-800">{resultado.modeloId}</span>
            </div>
            <span class={`text-sm font-bold ${getScoreColor(resultado.puntuacion)}`}>
              {resultado.puntuacion}
            </span>
          </div>
        ))}
      </div>
    </div>
  </div>
  
  <div class="border-t border-gray-100 px-6 py-4 bg-gray-50">
    <span class="text-sm font-medium text-indigo-600">
      Ver todos los resultados →
    </span>
  </div>
</a>
