---
import { withBase } from '@utils';

export interface ModelData {
  id: string;
  nombre: string;
  proveedor: string;
  precioInput: number;
  precioOutput: number;
  contextoVentana: number;
}

export interface Props {
  models: ModelData[];
  title?: string;
}

const { models, title = 'Comparativa de precios' } = Astro.props;

function formatPrice(price: number): string {
  if (price === 0) return 'Gratis';
  if (price < 0.01) return `$${price.toFixed(6)}`;
  if (price < 1) return `$${price.toFixed(4)}`;
  return `$${price.toFixed(2)}`;
}

function formatContext(tokens: number): string {
  if (tokens >= 1000000) return `${(tokens / 1000000).toFixed(1)}M`;
  if (tokens >= 1000) return `${(tokens / 1000).toFixed(0)}K`;
  return tokens.toString();
}

function calculateTotalPrice(input: number, output: number, inputTokens: number, outputTokens: number): number {
  return (input * inputTokens / 1000000) + (output * outputTokens / 1000000);
}
---

<div class="bg-white rounded-xl shadow-md overflow-hidden border border-gray-100">
  <div class="px-6 py-4 border-b border-gray-100">
    <h3 class="text-lg font-semibold text-gray-900">{title}</h3>
  </div>
  
  <div class="overflow-x-auto">
    <table class="min-w-full divide-y divide-gray-200">
      <thead class="bg-gray-50">
        <tr>
          <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">
            Modelo
          </th>
          <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">
            Proveedor
          </th>
          <th class="px-6 py-3 text-center text-xs font-medium text-gray-500 uppercase tracking-wider">
            Contexto
          </th>
          <th class="px-6 py-3 text-center text-xs font-medium text-gray-500 uppercase tracking-wider">
            Precio Input
          </th>
          <th class="px-6 py-3 text-center text-xs font-medium text-gray-500 uppercase tracking-wider">
            Precio Output
          </th>
          <th class="px-6 py-3 text-center text-xs font-medium text-gray-500 uppercase tracking-wider">
            Costo 1M tokens
          </th>
        </tr>
      </thead>
      <tbody class="bg-white divide-y divide-gray-200">
        {models.map((model) => {
          const totalCost = calculateTotalPrice(model.precioInput, model.precioOutput, 500000, 500000);
          return (
            <tr class="hover:bg-gray-50 transition-colors">
              <td class="px-6 py-4 whitespace-nowrap">
                <a href={withBase(`/modelos/${model.id}/`)} class="text-sm font-medium text-indigo-600 hover:text-indigo-800">
                  {model.nombre}
                </a>
              </td>
              <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500">
                {model.proveedor}
              </td>
              <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-900 text-center">
                {formatContext(model.contextoVentana)}
              </td>
              <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-900 text-center">
                {formatPrice(model.precioInput)}
              </td>
              <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-900 text-center">
                {formatPrice(model.precioOutput)}
              </td>
              <td class="px-6 py-4 whitespace-nowrap text-center">
                <span class={`text-sm font-medium ${totalCost < 1 ? 'text-green-600' : totalCost < 5 ? 'text-blue-600' : 'text-gray-900'}`}>
                  {formatPrice(totalCost)}
                </span>
              </td>
            </tr>
          );
        })}
      </tbody>
    </table>
  </div>
  
  <div class="px-6 py-4 bg-gray-50 border-t border-gray-100">
    <p class="text-xs text-gray-500">
      * Costo calculado para 500K tokens de input + 500K tokens de output
    </p>
  </div>
</div>
