---
import { withBase } from '@utils';
import { getCollection } from 'astro:content';
import BaseLayout from '../../components/BaseLayout.astro';

export async function getStaticPaths() {
  const modelos = await getCollection('modelos');
  return modelos.map((modelo) => ({
    params: { id: modelo.data.id },
    props: { modelo },
  }));
}

const { modelo } = Astro.props;

// Get all platforms that have this model
const plataformas = await getCollection('plataformas');
const plataformasConModelo = plataformas.filter(p => 
  p.data.modelos?.includes(modelo.data.id)
);

// Format price
function formatPrice(price: number): string {
  if (price === 0) return 'Gratis';
  return `$${price.toFixed(4)}`;
}

// Format context
function formatContext(context: number): string {
  if (context >= 1000000) return `${(context / 1000000).toFixed(1)}M`;
  if (context >= 1000) return `${(context / 1000).toFixed(0)}K`;
  return context.toString();
}
---

<BaseLayout title={modelo.data.nombre} currentPath={Astro.url.pathname}>
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
    <!-- Header -->
    <div class="mb-8">
      <a href={withBase('/modelos/')} class="text-blue-600 hover:text-blue-800 mb-4 inline-block">
        ← Volver a Modelos
      </a>
      <div class="flex items-center gap-4 mb-4">
        <span class="px-3 py-1 bg-blue-100 text-blue-800 rounded-full text-sm font-medium capitalize">
          {modelo.data.categoria}
        </span>
        <span class="px-3 py-1 bg-gray-100 text-gray-800 rounded-full text-sm font-medium">
          {modelo.data.proveedor}
        </span>
      </div>
      <h1 class="text-4xl font-bold text-gray-900 mb-4">{modelo.data.nombre}</h1>
    </div>

    <!-- Main Info -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-8 mb-12">
      <!-- Pricing Card -->
      <div class="bg-white rounded-xl shadow-lg p-6">
        <h2 class="text-xl font-bold text-gray-900 mb-4">Precios</h2>
        <div class="space-y-4">
          <div class="flex justify-between items-center py-3 border-b">
            <span class="text-gray-600">Input</span>
            <span class="font-semibold text-gray-900">{formatPrice(modelo.data.precio.input)} / 1K tokens</span>
          </div>
          <div class="flex justify-between items-center py-3 border-b">
            <span class="text-gray-600">Output</span>
            <span class="font-semibold text-gray-900">{formatPrice(modelo.data.precio.output)} / 1K tokens</span>
          </div>
          <div class="flex justify-between items-center py-3">
            <span class="text-gray-600">Contexto</span>
            <span class="font-semibold text-gray-900">{formatContext(modelo.data.contexto)} tokens</span>
          </div>
        </div>
      </div>

      <!-- Features Card -->
      <div class="bg-white rounded-xl shadow-lg p-6">
        <h2 class="text-xl font-bold text-gray-900 mb-4">Características</h2>
        <ul class="space-y-2">
          {modelo.data.caracteristicas?.map((caracteristica: string) => (
            <li class="flex items-center gap-2">
              <svg class="w-5 h-5 text-green-500" fill="currentColor" viewBox="0 0 20 20">
                <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/>
              </svg>
              <span class="text-gray-700">{caracteristica}</span>
            </li>
          ))}
        </ul>
      </div>
    </div>

    <!-- Benchmarks -->
    {modelo.data.benchmarks && Object.keys(modelo.data.benchmarks).length > 0 && (
      <div class="bg-white rounded-xl shadow-lg p-6 mb-12">
        <h2 class="text-xl font-bold text-gray-900 mb-4">Benchmarks</h2>
        <div class="grid grid-cols-2 md:grid-cols-4 gap-4">
          {Object.entries(modelo.data.benchmarks).map(([key, value]) => (
            <div class="text-center p-4 bg-gray-50 rounded-lg">
              <div class="text-2xl font-bold text-indigo-600">{value as number}</div>
              <div class="text-sm text-gray-600 capitalize">{key}</div>
            </div>
          ))}
        </div>
      </div>
    )}

    <!-- Platforms -->
    {plataformasConModelo.length > 0 && (
      <div class="bg-white rounded-xl shadow-lg p-6 mb-12">
        <h2 class="text-xl font-bold text-gray-900 mb-4">Disponible en</h2>
        <div class="flex flex-wrap gap-3">
          {plataformasConModelo.map((plataforma) => (
            <a 
              href={withBase(`/plataformas/${plataforma.data.id}/`)}
              class="px-4 py-2 bg-gray-100 hover:bg-gray-200 rounded-lg text-gray-800 font-medium transition-colors"
            >
              {plataforma.data.nombre}
            </a>
          ))}
        </div>
      </div>
    )}

    <!-- Launch Date -->
    {modelo.data.lanzamiento && (
      <div class="text-gray-500 text-sm mb-8">
        Lanzamiento: {new Date(modelo.data.lanzamiento).toLocaleDateString('es-ES', { year: 'numeric', month: 'long' })}
      </div>
    )}

    <!-- CTA -->
    <div class="bg-gradient-to-r from-blue-600 to-purple-600 rounded-xl p-8 text-center text-white">
      <h2 class="text-2xl font-bold mb-4">¿Quieres calcular el costo?</h2>
      <p class="mb-6 opacity-90">Usa nuestra calculadora para estimar el costo mensual según tu uso.</p>
      <a 
        href={withBase('/calculadora/')} 
        class="inline-block px-6 py-3 bg-white text-blue-600 font-semibold rounded-lg hover:bg-gray-100 transition-colors"
      >
        Ir a la Calculadora
      </a>
    </div>
  </div>
</BaseLayout>
