---
import { getCollection } from 'astro:content';
import BaseLayout from '../components/BaseLayout.astro';
import ModelCard from '../components/ModelCard.astro';

const modelos = await getCollection('modelos');

// Get featured models (first 6)
const featuredModels = modelos.slice(0, 6);
---

<BaseLayout title="LLM Compare" currentPath={Astro.url.pathname}>
  <!-- Hero Section -->
  <section class="bg-gradient-to-br from-indigo-600 via-purple-600 to-indigo-800 text-white py-20">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center">
        <h1 class="text-4xl md:text-6xl font-bold mb-6">
          Compara Modelos de Lenguaje
        </h1>
        <p class="text-xl md:text-2xl text-indigo-100 mb-8 max-w-3xl mx-auto">
          Encuentra el modelo perfecto para tu proyecto. Compara precios, rendimiento y características de los principales LLMs.
        </p>
        <div class="flex flex-col sm:flex-row gap-4 justify-center">
          <a 
            href="/modelos/" 
            class="inline-flex items-center justify-center px-6 py-3 bg-white text-indigo-600 font-semibold rounded-lg hover:bg-indigo-50 transition-colors"
          >
            Ver todos los modelos
          </a>
          <a 
            href="/calculadora/" 
            class="inline-flex items-center justify-center px-6 py-3 bg-indigo-500 text-white font-semibold rounded-lg hover:bg-indigo-400 transition-colors border border-indigo-400"
          >
            Calculadora de costos
          </a>
        </div>
      </div>
    </div>
  </section>
  
  <!-- Stats Section -->
  <section class="py-12 bg-white border-b border-gray-200">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-2 md:grid-cols-4 gap-8">
        <div class="text-center">
          <p class="text-4xl font-bold text-indigo-600">{modelos.length}</p>
          <p class="text-gray-600">Modelos</p>
        </div>
        <div class="text-center">
          <p class="text-4xl font-bold text-indigo-600">3</p>
          <p class="text-gray-600">Plataformas</p>
        </div>
        <div class="text-center">
          <p class="text-4xl font-bold text-indigo-600">4</p>
          <p class="text-gray-600">Benchmarks</p>
        </div>
        <div class="text-center">
          <p class="text-4xl font-bold text-indigo-600">6</p>
          <p class="text-gray-600">Recomendaciones</p>
        </div>
      </div>
    </div>
  </section>
  
  <!-- Featured Models -->
  <section class="py-16 bg-gray-50">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-12">
        <h2 class="text-3xl font-bold text-gray-900 mb-4">Modelos Destacados</h2>
        <p class="text-gray-600 max-w-2xl mx-auto">
          Los modelos más populares y utilizados por desarrolladores de todo el mundo.
        </p>
      </div>
      
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        {featuredModels.map((modelo) => (
          <ModelCard
            id={modelo.data.id}
            nombre={modelo.data.nombre}
            proveedor={modelo.data.proveedor}
            categoria={modelo.data.categoria}
            contexto={modelo.data.contexto}
            precio={modelo.data.precio}
            caracteristicas={modelo.data.caracteristicas}
            disponibleEn={modelo.data.disponibleEn}
          />
        ))}
      </div>
      
      <div class="text-center mt-8">
        <a 
          href="/modelos/" 
          class="inline-flex items-center px-6 py-3 bg-indigo-600 text-white font-semibold rounded-lg hover:bg-indigo-700 transition-colors"
        >
          Ver todos los modelos
          <svg class="ml-2 w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" />
          </svg>
        </a>
      </div>
    </div>
  </section>
  
  <!-- Features Section -->
  <section class="py-16 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-12">
        <h2 class="text-3xl font-bold text-gray-900 mb-4">¿Por qué usar LLM Compare?</h2>
      </div>
      
      <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
        <div class="text-center p-6">
          <div class="w-16 h-16 bg-indigo-100 rounded-full flex items-center justify-center mx-auto mb-4">
            <svg class="w-8 h-8 text-indigo-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
            </svg>
          </div>
          <h3 class="text-xl font-semibold text-gray-900 mb-2">Comparación de Precios</h3>
          <p class="text-gray-600">
            Compara los precios de entrada y salida por millón de tokens entre diferentes modelos.
          </p>
        </div>
        
        <div class="text-center p-6">
          <div class="w-16 h-16 bg-green-100 rounded-full flex items-center justify-center mx-auto mb-4">
            <svg class="w-8 h-8 text-green-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z" />
            </svg>
          </div>
          <h3 class="text-xl font-semibold text-gray-900 mb-2">Benchmarks</h3>
          <p class="text-gray-600">
            Resultados de benchmarks estandarizados para evaluar el rendimiento de cada modelo.
          </p>
        </div>
        
        <div class="text-center p-6">
          <div class="w-16 h-16 bg-purple-100 rounded-full flex items-center justify-center mx-auto mb-4">
            <svg class="w-8 h-8 text-purple-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.663 17h4.673M12 3v1m6.364 1.636l-.707.707M21 12h-1M4 12H3m3.343-5.657l-.707-.707m2.828 9.9a5 5 0 117.072 0l-.548.547A3.374 3.374 0 0014 18.469V19a2 2 0 11-4 0v-.531c0-.895-.356-1.754-.988-2.386l-.548-.547z" />
            </svg>
          </div>
          <h3 class="text-xl font-semibold text-gray-900 mb-2">Recomendaciones</h3>
          <p class="text-gray-600">
            Guías personalizadas según tu perfil: desarrollador, startup, empresa o estudiante.
          </p>
        </div>
      </div>
    </div>
  </section>
  
  <!-- CTA Section -->
  <section class="py-16 bg-gray-900">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <h2 class="text-3xl font-bold text-white mb-4">
        ¿Listo para encontrar tu modelo ideal?
      </h2>
      <p class="text-gray-300 mb-8 max-w-2xl mx-auto">
        Usa nuestra calculadora de costos para estimar cuánto pagarás según tu uso.
      </p>
      <a 
        href="/calculadora/" 
        class="inline-flex items-center px-8 py-4 bg-indigo-600 text-white font-semibold rounded-lg hover:bg-indigo-500 transition-colors"
      >
        Probar calculadora
        <svg class="ml-2 w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" />
        </svg>
      </a>
    </div>
  </section>
</BaseLayout>