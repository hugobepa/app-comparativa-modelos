---
import { withBase } from '@utils';
import { getCollection } from 'astro:content';
import BaseLayout from '../../components/BaseLayout.astro';
import ModelCard from '../../components/ModelCard.astro';

export async function getStaticPaths() {
  const plataformas = await getCollection('plataformas');
  return plataformas.map((plataforma) => ({
    params: { id: plataforma.data.id },
    props: { plataforma },
  }));
}

const { plataforma } = Astro.props;

// Get all models for this platform
const modelos = await getCollection('modelos');
const modelosPlataforma = modelos.filter(m => 
  plataforma.data.modelos.includes(m.data.id)
);

// Get all unique features from all plans
const todasCaracteristicas = new Set<string>();
plataforma.data.planes.forEach(plan => {
  plan.caracteristicas.forEach(c => todasCaracteristicas.add(c));
});

function formatPrice(price: number): string {
  if (price === 0) return 'Gratis';
  return `$${price}/mes`;
}
---

<BaseLayout title={plataforma.data.nombre} currentPath={Astro.url.pathname}>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
    <!-- Header -->
    <div class="mb-8">
      <a href={withBase('/plataformas/')} class="text-blue-600 hover:text-blue-800 mb-4 inline-block">
        ← Volver a Plataformas
      </a>
      <h1 class="text-4xl font-bold text-gray-900 mb-4">{plataforma.data.nombre}</h1>
      <p class="text-xl text-gray-600 mb-6">{plataforma.data.descripcion}</p>
      
      <a 
        href={plataforma.data.url} 
        target="_blank" 
        rel="noopener noreferrer"
        class="inline-flex items-center gap-2 px-6 py-3 bg-blue-600 text-white font-semibold rounded-lg hover:bg-blue-700 transition-colors"
      >
        Visitar Plataforma
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"/>
        </svg>
      </a>
    </div>

    <!-- Plans -->
    <div class="bg-white rounded-xl shadow-lg p-6 mb-12">
      <h2 class="text-xl font-bold text-gray-900 mb-6">Planes</h2>
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        {plataforma.data.planes.map((plan) => (
          <div class="border border-gray-200 rounded-lg p-4">
            <div class="flex justify-between items-start mb-3">
              <h3 class="font-bold text-gray-900">{plan.nombre}</h3>
              <span class="text-lg font-bold text-indigo-600">{formatPrice(plan.precioMensual)}</span>
            </div>
            <ul class="space-y-2">
              {plan.caracteristicas.map((c: string) => (
                <li class="flex items-start gap-2 text-sm text-gray-600">
                  <svg class="w-4 h-4 text-green-500 mt-0.5 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20">
                    <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/>
                  </svg>
                  {c}
                </li>
              ))}
            </ul>
          </div>
        ))}
      </div>
    </div>

    <!-- Available Models -->
    <div class="mb-12">
      <h2 class="text-2xl font-bold text-gray-900 mb-6">
        Modelos Disponibles ({modelosPlataforma.length})
      </h2>
      {modelosPlataforma.length > 0 ? (
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
          {modelosPlataforma.map((modelo) => (
            <ModelCard
              id={modelo.data.id}
              nombre={modelo.data.nombre}
              proveedor={modelo.data.proveedor}
              categoria={modelo.data.categoria}
              contexto={modelo.data.contexto}
              precio={modelo.data.precio}
            />
          ))}
        </div>
      ) : (
        <p class="text-gray-600">No hay modelos disponibles registrados para esta plataforma.</p>
      )}
    </div>
  </div>
</BaseLayout>
